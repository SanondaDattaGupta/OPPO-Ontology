@prefix : <http://umaine.edu/oppo/core/v1#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dpvo: <https://w3id.org/dpv/dpv-owl#> .
@prefix gdpr: <http://umaine.edu/gdpr#> .
@prefix oppo: <http://umaine.edu/oppo/core/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix terms: <http://purl.org/dc/terms/> .
@base <http://umaine.edu/oppo/core/v1#> .

<http://umaine.edu/oppo/core/v1#> rdf:type owl:Ontology ;

    terms:title "OPPO: Ontology for Privacy Policies of Online Social Networks"@en ;

    terms:description "An ontology for representing fine-grained data retention, storage, and security practices described in online social network privacy policies."@en ;

    terms:creator "Sanonda Datta Gupta" ,
                  "Torsten Hahmann" ;

    terms:license <https://creativecommons.org/licenses/by/4.0/> ;

    owl:versionInfo "1.0.0" ;

    owl:imports
        <http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl> ,
        <http://www.w3.org/2006/time> ,
        <https://raw.githubusercontent.com/SanondaDattaGupta/OPPO-Ontology/main/Ontology/OPPO-IAO-Ontology.ttl> ,
        <https://raw.githubusercontent.com/SanondaDattaGupta/OPPO-Ontology/main/Ontology/OPPO-OBI-Ontology.ttl> ,
        <https://raw.githubusercontent.com/SanondaDattaGupta/OPPO-Ontology/main/Ontology/OPPO-OMRSE-ontology.ttl> ,
        <https://raw.githubusercontent.com/SanondaDattaGupta/OPPO-Ontology/main/Ontology/dpvo-ontology.ttl> .


#################################################################
#
#    Annotation properties
#
#################################################################


###  http://www.w3.org/2004/02/skos/core#definition

skos:definition rdf:type owl:AnnotationProperty .



###  http://www.w3.org/2004/02/skos/core#note

skos:note rdf:type owl:AnnotationProperty .





#################################################################
#
#    Object Properties
#
#################################################################


###  http://umaine.edu/oppo/core/v1#actsIn

:actsIn rdf:type owl:AsymmetricProperty ,
                 owl:ObjectProperty ;
        
        rdfs:label "acts in" ;
        
        rdfs:domain obo:OBI_0000245 ;
        
        rdfs:range obo:OMRSE_00000051 .



###  http://umaine.edu/oppo/core/v1#actsOn

:actsOn rdf:type owl:AsymmetricProperty ,
                 owl:ObjectProperty ;
        
        rdfs:label "acts on" ;
        
        rdfs:range obo:IAO_0000027 ;
        
        rdfs:domain :DataPractice .



###  http://umaine.edu/oppo/core/v1#allows

:allows rdf:type owl:AsymmetricProperty ,
                 owl:ObjectProperty ;
        
        rdfs:label "allows" ;
        
        rdfs:range :DataPractice ;
        
        rdfs:domain :PrivacyRegulation .



###  http://umaine.edu/oppo/core/v1#appliesTo

:appliesTo rdf:type owl:AsymmetricProperty ,
                    owl:ObjectProperty ;
           
           rdfs:label "applies to" ;
           
           rdfs:range obo:IAO_0000027 ;
           
           rdfs:domain :SecurityMechanism .



###  http://umaine.edu/oppo/core/v1#disallows

:disallows rdf:type owl:AsymmetricProperty ,
                    owl:ObjectProperty ;
           
           rdfs:label "disallows" ;
           
           rdfs:range :DataPractice ;
           
           rdfs:domain :PrivacyRegulation .



###  http://umaine.edu/oppo/core/v1#hasDataPractice

:hasDataPractice rdf:type owl:AsymmetricProperty ,
                          owl:ObjectProperty ;
                 
                 rdfs:label "has data practice" ;
                 
                 rdfs:range :DataPractice ;
                 
                 rdfs:domain :PrivacyPolicy .



###  http://umaine.edu/oppo/core/v1#hasDurationDescription

:hasDurationDescription rdf:type owl:AsymmetricProperty ,
                                 owl:ObjectProperty ;
                        
                        rdfs:label "has duration description" ;
                        
                        rdfs:domain :DataStorageDurationPractice ;
                        
                        rdfs:range time:GeneralDurationDescription .



###  http://umaine.edu/oppo/core/v1#hasPolicy

:hasPolicy rdf:type owl:AsymmetricProperty ,
                    owl:ObjectProperty ;
           
           rdfs:label "has policy" ;
           
           rdfs:domain obo:OBI_0000245 ;
           
           rdfs:range :PrivacyPolicy .



###  http://umaine.edu/oppo/core/v1#hasPurpose

:hasPurpose rdf:type owl:AsymmetricProperty ,
                     owl:ObjectProperty ;
            
            rdfs:label "has purpose" ;
            
            rdfs:domain :DataPractice ;
            
            rdfs:range dpvo:Purpose .



###  http://umaine.edu/oppo/core/v1#hasResponseDelay

:hasResponseDelay rdf:type owl:AsymmetricProperty ,
                           owl:ObjectProperty ;
                  
                  rdfs:label "has response delay" ;
                  
                  rdfs:domain :DataStorageModificationPractice ;
                  
                  rdfs:range time:GeneralDurationDescription .



###  http://umaine.edu/oppo/core/v1#hasSecurityMechanism

:hasSecurityMechanism rdf:type owl:AsymmetricProperty ,
                               owl:ObjectProperty ;
                      
                      rdfs:label "has security mechanism" ;
                      
                      rdfs:domain :DataPractice ;
                      
                      rdfs:range :SecurityMechanism .



###  http://umaine.edu/oppo/core/v1#hasStorageEntity

:hasStorageEntity rdf:type owl:AsymmetricProperty ,
                           owl:ObjectProperty ;
                  
                  rdfs:label "has storage entity" ;
                  
                  rdfs:domain :DataStorageLocationPractice ;
                  
                  rdfs:range :StorageEntity .



###  http://umaine.edu/oppo/core/v1#hasStorageLocation

:hasStorageLocation rdf:type owl:AsymmetricProperty ,
                             owl:ObjectProperty ;
                    
                    rdfs:label "has storage location" ;
                    
                    rdfs:domain :DataStorageLocationPractice ;
                    
                    rdfs:range :SpatialEntity .



###  http://umaine.edu/oppo/core/v1#isAbout

:isAbout rdf:type owl:AsymmetricProperty ,
                  owl:ObjectProperty ;
         
         rdfs:label "is about" ;
         
         rdfs:domain obo:IAO_0000027 ;
         
         rdfs:range :DataSubjectRole .



###  http://umaine.edu/oppo/core/v1#isProvidedBy

:isProvidedBy rdf:type owl:AsymmetricProperty ,
                       owl:ObjectProperty ;
              
              rdfs:label "is provided by" ;
              
              rdfs:domain obo:IAO_0000027 ;
              
              rdfs:range :DataProviderRole .



###  http://umaine.edu/oppo/core/v1#isReceivedBy

:isReceivedBy rdf:type owl:AsymmetricProperty ,
                       owl:ObjectProperty ;
              
              rdfs:label "is received by" ;
              
              rdfs:domain obo:IAO_0000027 ;
              
              rdfs:range :DataRecipientRole .



###  http://umaine.edu/oppo/core/v1#isRecipientOf

:isRecipientOf rdf:type owl:AsymmetricProperty ,
                        owl:ObjectProperty ;
               
               rdfs:label "is recipient of" ;
               
               rdfs:range obo:IAO_0000027 ;
               
               rdfs:domain :DataRecipientRole ;
               
               owl:inverseOf :isReceivedBy .



###  http://umaine.edu/oppo/core/v1#providesAccessTo

:providesAccessTo rdf:type owl:ObjectProperty ;
                  
                  rdfs:label "provides access to"@en ;
                  
                  skos:definition "Relates a data security access practice description to the material entity role that the policy states is authorized to access the relevant data."@en ;
                  
                  rdfs:range obo:OMRSE_00000048 ;
                  
                  rdfs:domain :DataSecurityAccessPractice .





