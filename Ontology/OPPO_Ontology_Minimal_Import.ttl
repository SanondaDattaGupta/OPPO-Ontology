###  http://purl.obolibrary.org/obo/BFO_0000002

obo:BFO_0000002 rdf:type owl:Class ;
                
                owl:disjointWith obo:BFO_0000003 .



###  http://purl.obolibrary.org/obo/BFO_0000003

obo:BFO_0000003 rdf:type owl:Class .



###  http://purl.obolibrary.org/obo/BFO_0000004

obo:BFO_0000004 rdf:type owl:Class ;
                
                rdfs:label "independent continuant" ;
                
                rdfs:subClassOf obo:BFO_0000002 .



###  http://purl.obolibrary.org/obo/BFO_0000006

obo:BFO_0000006 rdf:type owl:Class ;
                
                rdfs:subClassOf :SpatialEntity .



###  http://purl.obolibrary.org/obo/BFO_0000011

obo:BFO_0000011 rdf:type owl:Class ;
                
                rdfs:label "spatiotemporal region" ;
                
                rdfs:subClassOf obo:BFO_0000003 .



###  http://purl.obolibrary.org/obo/BFO_0000015

obo:BFO_0000015 rdf:type owl:Class ;
                
                rdfs:label "process" ;
                
                rdfs:subClassOf obo:BFO_0000003 .



###  http://purl.obolibrary.org/obo/BFO_0000016

obo:BFO_0000016 rdf:type owl:Class ;
                
                rdfs:label "disposition" ;
                
                rdfs:subClassOf obo:BFO_0000017 .



###  http://purl.obolibrary.org/obo/BFO_0000017

obo:BFO_0000017 rdf:type owl:Class ;
                
                rdfs:label "realizable entity" ;
                
                rdfs:subClassOf obo:BFO_0000020 .



###  http://purl.obolibrary.org/obo/BFO_0000020

obo:BFO_0000020 rdf:type owl:Class ;
                
                rdfs:label "specifically dependent continuant" ;
                
                rdfs:subClassOf obo:BFO_0000002 .



###  http://purl.obolibrary.org/obo/BFO_0000023

obo:BFO_0000023 rdf:type owl:Class ;
                
                rdfs:label "role" ;
                
                rdfs:subClassOf obo:BFO_0000017 .



###  http://purl.obolibrary.org/obo/BFO_0000029

obo:BFO_0000029 rdf:type owl:Class ;
                
                rdfs:label "site" ;
                
                rdfs:subClassOf :SpatialEntity .



###  http://purl.obolibrary.org/obo/BFO_0000031

obo:BFO_0000031 rdf:type owl:Class ;
                
                rdfs:label "generically dependent continuant" ;
                
                rdfs:subClassOf obo:BFO_0000002 .



###  http://purl.obolibrary.org/obo/BFO_0000035

obo:BFO_0000035 rdf:type owl:Class ;
                
                rdfs:label "process boundary" ;
                
                rdfs:subClassOf obo:BFO_0000003 .



###  http://purl.obolibrary.org/obo/BFO_0000040

obo:BFO_0000040 rdf:type owl:Class ;
                
                rdfs:label "material entity" ;
                
                rdfs:subClassOf obo:BFO_0000004 ;
                
                owl:disjointWith obo:BFO_0000141 .



###  http://purl.obolibrary.org/obo/BFO_0000140

obo:BFO_0000140 rdf:type owl:Class ;
                
                rdfs:label "continuant fiat boundary" ;
                
                rdfs:subClassOf obo:BFO_0000141 .



###  http://purl.obolibrary.org/obo/BFO_0000141

obo:BFO_0000141 rdf:type owl:Class ;
                
                rdfs:label "immaterial entity" ;
                
                rdfs:subClassOf obo:BFO_0000004 .



###  http://purl.obolibrary.org/obo/IAO_0000027

obo:IAO_0000027 rdf:type owl:Class ;
                
                rdfs:label "data item" ;
                
                rdfs:subClassOf obo:IAO_0000030 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isAbout ;
                                  owl:someValuesFrom :DataSubjectRole
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isProvidedBy ;
                                  owl:someValuesFrom :DataProviderRole
                                ] ;
                
                owl:disjointWith :DataPractice .



###  http://purl.obolibrary.org/obo/IAO_0000030

obo:IAO_0000030 rdf:type owl:Class ;
                
                rdfs:label "information content entity" ;
                
                rdfs:subClassOf obo:BFO_0000031 .



###  http://purl.obolibrary.org/obo/IAO_0000178

obo:IAO_0000178 rdf:type owl:Class ;
                
                rdfs:label "material information bearer" ;
                
                rdfs:subClassOf obo:BFO_0000040 .



###  http://purl.obolibrary.org/obo/NCBITaxon_9606

obo:NCBITaxon_9606 rdf:type owl:Class ;
                   
                   rdfs:label "homo sapiens" ;
                   
                   rdfs:subClassOf obo:BFO_0000040 .



###  http://purl.obolibrary.org/obo/OBI_0000245

obo:OBI_0000245 rdf:type owl:Class ;
                
                rdfs:label "organization"@en ;
                
                rdfs:subClassOf obo:BFO_0000040 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :actsIn ;
                                  owl:someValuesFrom obo:OMRSE_00000051
                                ] ;
                
                obo:IAO_0000116 """BP: The definition summarizes long email discussions on the OBI developer, roles, biomaterial and denrie branches. It leaves open if an organization is a material entity or a dependent continuant, as no consensus was reached on that.  The current placement as material is therefore temporary, in order to move forward with development. Here is the entire email summary, on which the definition is based:

1) there are organization_member_roles (president, treasurer, branch
editor), with individual persons as bearers

2) there are organization_roles (employer, owner, vendor, patent holder)

3) an organization has a charter / rules / bylaws, which specify what roles
there are, how they should be realized, and how to modify the
charter/rules/bylaws themselves.

It is debatable what the organization itself is (some kind of dependent
continuant or an aggregate of people). This also determines who/what the
bearer of organization_roles' are. My personal favorite is still to define
organization as a kind of 'legal entity', but thinking it through leads to
all kinds of questions that are clearly outside the scope of OBI.

Interestingly enough, it does not seem to matter much where we place
organization itself, as long as we can subclass it (University, Corporation,
Government Agency, Hospital), instantiate it (Affymetrix, NCBI, NIH, ISO,
W3C, University of Oklahoma), and have it play roles.

This leads to my proposal: We define organization through the statements 1 -
3 above, but without an 'is a' statement for now. We can leave it in its
current place in the is_a hierarchy (material entity) or move it up to
'continuant'. We leave further clarifications to BFO, and close this issue
for now."""@en ;
                
                obo:IAO_0000117 "PERSON: Philippe Rocca-Serra" ,
                                "PERSON: Alan Ruttenberg" ;
                
                obo:IAO_0000119 "GROUP: OBI" ;
                
                obo:IAO_0000115 "An entity that can bear roles, has members, and has a set of organization rules. Members of organizations are either organizations themselves or individual people. Members can bear specific organization member roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the organization by the organization members."@en ;
                
                obo:IAO_0000117 "PERSON: Bjoern Peters" ,
                                "PERSON: Susanna Sansone" ;
                
                obo:IAO_0000112 "PMID: 16353909.AAPS J. 2005 Sep 22;7(2):E274-80. Review. The joint food and agriculture organization of the United Nations/World Health Organization Expert Committee on Food Additives and its role in the evaluation of the safety of veterinary drug residues in foods."@en ;
                
                obo:IAO_0000111 "organization"@en ;
                
                obo:IAO_0000114 obo:IAO_0000122 .



###  http://purl.obolibrary.org/obo/OMRSE_00000023

obo:OMRSE_00000023 rdf:type owl:Class ;
                   
                   rdfs:label "collection of humans" ;
                   
                   rdfs:subClassOf obo:BFO_0000040 .



###  http://purl.obolibrary.org/obo/OMRSE_00000038

obo:OMRSE_00000038 rdf:type owl:Class ;
                   
                   rdfs:label "legal person role" ;
                   
                   rdfs:subClassOf obo:OMRSE_00002072 .



###  http://purl.obolibrary.org/obo/OMRSE_00000048

obo:OMRSE_00000048 rdf:type owl:Class ;
                   
                   rdfs:label "material entity role" ;
                   
                   rdfs:subClassOf obo:BFO_0000023 .



###  http://purl.obolibrary.org/obo/OMRSE_00000051

obo:OMRSE_00000051 rdf:type owl:Class ;
                   
                   rdfs:label "organization role" ;
                   
                   rdfs:subClassOf obo:OMRSE_00000048 .



###  http://purl.obolibrary.org/obo/OMRSE_00002072

obo:OMRSE_00002072 rdf:type owl:Class ;
                   
                   rdfs:label "role in human social processes" ;
                   
                   rdfs:subClassOf obo:OMRSE_00000048 .



###  http://umaine.edu/gdpr#GDPRMinorDataSubject

gdpr:GDPRMinorDataSubject rdf:type owl:Class ;
                          
                          rdfs:label "GDPR minor data subject"@en ;
                          
                          rdfs:subClassOf :MinorDataSubjectRole .



###  http://umaine.edu/gdpr#HealthData

gdpr:HealthData rdf:type owl:Class ;
                
                rdfs:label "GDPR Health Data"@en ;
                
                rdfs:subClassOf gdpr:SpecialCategoryPersonalData .



###  http://umaine.edu/gdpr#HealthStatusData

gdpr:HealthStatusData rdf:type owl:Class ;
                      
                      rdfs:label "Health Status Data"@en ;
                      
                      rdfs:subClassOf :HealthPersonalData .



###  http://umaine.edu/gdpr#SpecialCategoryPersonalData

gdpr:SpecialCategoryPersonalData rdf:type owl:Class ;
                                 
                                 rdfs:label "GDPR Special Category Personal Data"@en ;
                                 
                                 rdfs:subClassOf :PersonalData .



###  http://umaine.edu/oppo/core/v1#ActivityPersonalData

:ActivityPersonalData rdf:type owl:Class ;
                      
                      rdfs:label "activity personal data"@en ;
                      
                      rdfs:subClassOf :PersonalData ;
                      
                      skos:definition "Data that reflects the activity of an individual, such as food habits, sleeping log, or social media post." .



###  http://umaine.edu/oppo/core/v1#AggregatedData

:AggregatedData rdf:type owl:Class ;
                
                rdfs:label "aggregated data"@en ;
                
                rdfs:subClassOf obo:IAO_0000027 ;
                
                owl:disjointWith :IndividualData ;
                
                skos:note "https://en.wikipedia.org/wiki/Aggregate_data" ;
                
                skos:definition "Agrregated data is the high-level data that is acuired by aggregating individual-level data." .



###  http://umaine.edu/oppo/core/v1#AnonymizedData

:AnonymizedData rdf:type owl:Class ;
                
                rdfs:label "anonymized data"@en ;
                
                rdfs:subClassOf :IndividualData ;
                
                owl:disjointWith :PersonalData ;
                
                skos:note "https://ico.org.uk/media/about-the-ico/consultations/2619862/anonymisation-intro-and-first-chapter.pdf" ;
                
                skos:definition "Data which does not relate to an identified or identifiable natural person or to personal data rendered anonymous in such a manner that the data subject is not or no longer identifiable." .



###  http://umaine.edu/oppo/core/v1#AuthenticationMechanism

:AuthenticationMechanism rdf:type owl:Class ;
                         
                         rdfs:label "authentication mechanism"@en ;
                         
                         rdfs:subClassOf :SecurityMechanism ;
                         
                         skos:definition "Authentication mechanism refers to the types of security mechanism, which enable the authenticated users to have access to their personal information. Usually OSNs follow two types of authentication mechanism: One Factor Authentication Mechanism and Two Factor Authentication Mechanism." .



###  http://umaine.edu/oppo/core/v1#BiometricPersonalData

:BiometricPersonalData rdf:type owl:Class ;
                       
                       rdfs:label "biometric personal data"@en ;
                       
                       rdfs:subClassOf gdpr:SpecialCategoryPersonalData ,
                                       :PersonalData ;
                       
                       skos:note "Please also see: https://www.techtarget.com/searchsecurity/definition/biometrics" ;
                       
                       skos:definition "Biometric is the measurement and statistical analysis of people's unique and behavioral characteristics."@en .



###  http://umaine.edu/oppo/core/v1#BiometrybasedAuthenticationMechanism

:BiometrybasedAuthenticationMechanism rdf:type owl:Class ;
                                      
                                      rdfs:label "Biometry-based Authentication Mechanism"@en ;
                                      
                                      rdfs:subClassOf :OneFactorAuthenticationMechanism ;
                                      
                                      skos:definition "a single factor authentication mechanism which requires to match any biometric information such as fingerprint and facial recognition." .



###  http://umaine.edu/oppo/core/v1#CryptographicHashingMechanism

:CryptographicHashingMechanism rdf:type owl:Class ;
                               
                               rdfs:label "cryptographic hashing mechanism"@en ;
                               
                               rdfs:subClassOf :HashingMechanism ;
                               
                               skos:definition "A hashing mechanism that uses a cryptographic hash function to transform data in a manner intended to prevent recovery of the original data."@en .



###  http://umaine.edu/oppo/core/v1#DataPractice

:DataPractice rdf:type owl:Class ;
              
              rdfs:label "data practice"@en ;
              
              rdfs:subClassOf obo:IAO_0000030 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasPurpose ;
                                owl:someValuesFrom dpvo:Purpose
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :actsOn ;
                                owl:someValuesFrom obo:IAO_0000027
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasSecurityMechanism ;
                                owl:someValuesFrom :SecurityMechanism
                              ] ;
              
              owl:disjointWith :PrivacyPolicy ,
                               :PrivacyRegulation ,
                               :SecurityMechanism ;
              
              skos:definition "An information content entity that describes a data practice stated in a privacy policy, such as how an organization stores, retains, modifies, or secures data."@en .



###  http://umaine.edu/oppo/core/v1#DataProviderRole

:DataProviderRole rdf:type owl:Class ;
                  
                  rdfs:label "data provider role"@en ;
                  
                  rdfs:subClassOf obo:OMRSE_00000048 ;
                  
                  skos:definition "Data provider defines as organizations or individuals which provide data to another organization(s) or individual(s)." .



###  http://umaine.edu/oppo/core/v1#DataRecipientRole

:DataRecipientRole rdf:type owl:Class ;
                   
                   rdfs:label "data recipient role"@en ;
                   
                   rdfs:subClassOf obo:OMRSE_00000051 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :isRecipientOf ;
                                     owl:someValuesFrom obo:IAO_0000027
                                   ] ;
                   
                   skos:definition "Data provider can be any organization or individual who provides data to the organization." .



###  http://umaine.edu/oppo/core/v1#DataSecurityAccessPractice

:DataSecurityAccessPractice rdf:type owl:Class ;
                            
                            rdfs:label "data security access practice"@en ;
                            
                            rdfs:subClassOf :DataSecurityPractice ;
                            
                            skos:definition "security practices that limit the access to data, thus prevent unauthorized access to the users' data." .



###  http://umaine.edu/oppo/core/v1#DataSecurityAuditingPractice

:DataSecurityAuditingPractice rdf:type owl:Class ;
                              
                              rdfs:label "data security auditing practice"@en ;
                              
                              rdfs:subClassOf :DataSecurityPractice ;
                              
                              skos:definition "a practice to inspect if the organization is followeing proper safeguard mecanisms to protect the collected data." .



###  http://umaine.edu/oppo/core/v1#DataSecurityPractice

:DataSecurityPractice rdf:type owl:Class ;
                      
                      rdfs:label "data security practice"@en ;
                      
                      rdfs:subClassOf :DataPractice ;
                      
                      skos:definition "According to the privacy regulations organization are required to mainatin proper security to protect the collected data-- often referred as  data security practice." .



###  http://umaine.edu/oppo/core/v1#DataSecurityRestorationPractice

:DataSecurityRestorationPractice rdf:type owl:Class ;
                                 
                                 rdfs:label "data security restoration practice"@en ;
                                 
                                 rdfs:subClassOf :DataSecurityPractice ;
                                 
                                 skos:definition "a practice that describes how a lost data can be recovered." .



###  http://umaine.edu/oppo/core/v1#DataStorageDurationPractice

:DataStorageDurationPractice rdf:type owl:Class ;
                             
                             rdfs:label "data storage duration practice"@en ;
                             
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:intersectionOf ( :DataStoragePractice
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :hasDurationDescription ;
                                                                          owl:someValuesFrom time:GeneralDurationDescription
                                                                        ]
                                                                      )
                                                 ] ;
                             
                             rdfs:subClassOf :DataStoragePractice ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :hasDurationDescription ;
                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                             ] ;
                             
                             skos:definition "The data practices that discusses about the duration of the storage of personal data." .



###  http://umaine.edu/oppo/core/v1#DataStorageErasurePractice

:DataStorageErasurePractice rdf:type owl:Class ;
                            
                            rdfs:label "data storage erasure practice"@en ;
                            
                            rdfs:subClassOf :DataStorageModificationPractice ;
                            
                            skos:definition "Privacy regulations such as GDPR and CCPA require organizations to provide users with right to erase the stored data. The data practices related to erasure of collected or stored data include how long it takes to process users' deletion request or how the user can exercise the data erasure right (Request type)." .



###  http://umaine.edu/oppo/core/v1#DataStorageLocationPractice

:DataStorageLocationPractice rdf:type owl:Class ;
                             
                             rdfs:label "data storage location practice"@en ;
                             
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:intersectionOf ( :DataStoragePractice
                                                                        [ rdf:type owl:Class ;
                                                                          owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty :hasStorageEntity ;
                                                                                          owl:someValuesFrom :StorageEntity
                                                                                        ]
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty :hasStorageLocation ;
                                                                                          owl:someValuesFrom :SpatialEntity
                                                                                        ]
                                                                                      )
                                                                        ]
                                                                      )
                                                 ] ;
                             
                             rdfs:subClassOf :DataStoragePractice ;
                             
                             skos:definition "The data practices that discuss where and how the collected data is stored." .



###  http://umaine.edu/oppo/core/v1#DataStorageModificationPractice

:DataStorageModificationPractice rdf:type owl:Class ;
                                 
                                 rdfs:label "data storage modification practice"@en ;
                                 
                                 rdfs:subClassOf :DataStoragePractice ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasResponseType ;
                                                   owl:someValuesFrom xsd:string
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasResponseDelay ;
                                                   owl:cardinality "1"^^xsd:nonNegativeInteger
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :actsOn ;
                                                   owl:someValuesFrom obo:IAO_0000027
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasRequestType ;
                                                   owl:someValuesFrom xsd:string
                                                 ] ;
                                 
                                 skos:definition "The data practices that discuss how the data subject can modify (rectify/erase) the stored data." .



###  http://umaine.edu/oppo/core/v1#DataStoragePractice

:DataStoragePractice rdf:type owl:Class ;
                     
                     rdfs:label "data storage practice"@en ;
                     
                     rdfs:subClassOf :DataPractice ;
                     
                     skos:definition "Data practices that discusses about the storage of the collected data." .



###  http://umaine.edu/oppo/core/v1#DataStorageRectificationPractice

:DataStorageRectificationPractice rdf:type owl:Class ;
                                  
                                  rdfs:label "data storage rectification practice"@en ;
                                  
                                  rdfs:subClassOf :DataStorageModificationPractice ;
                                  
                                  skos:definition "Privacy regulations such as GDPR and CCPA require organizations to provide users with right to modify or update the stored inaccurate data. The data practices related to  modification of collected or stored data include how long it takes to process users' data modification request or how the user can exercise the data rectification right." .



###  http://umaine.edu/oppo/core/v1#DataSubjectRole

:DataSubjectRole rdf:type owl:Class ;
                 
                 rdfs:label "data subject role"@en ;
                 
                 rdfs:subClassOf obo:OMRSE_00000038 ;
                 
                 skos:definition "Data subject is defined as an individual from which an organization or OSN may collect data. In other word, Data subject is an individual who can identified directly or indirectly by the collected data. Note that a data subject can also be a data provider." .



###  http://umaine.edu/oppo/core/v1#DefiniteDurationDescription

:DefiniteDurationDescription rdf:type owl:Class ;
                             
                             rdfs:label "Definite Duration Description"@en ;
                             
                             rdfs:subClassOf time:GeneralDurationDescription ;
                             
                             owl:disjointWith :IndefiniteDurationDescription ;
                             
                             skos:definition "An organization may describe specifically (definite) how long the collected data will be stored (retention period) or how long the organization may take to response to users' request (response delay), referred as definite duration description." .



###  http://umaine.edu/oppo/core/v1#DemographicPersonalData

:DemographicPersonalData rdf:type owl:Class ;
                         
                         rdfs:label "demographic personal data"@en ;
                         
                         rdfs:subClassOf :PersonalData ;
                         
                         skos:definition "Any socioeconomic information such as age, income, birth date." .



###  http://umaine.edu/oppo/core/v1#EncryptionMechanism

:EncryptionMechanism rdf:type owl:Class ;
                     
                     rdfs:label "encryption mechanism"@en ;
                     
                     rdfs:subClassOf :SecurityMechanism ;
                     
                     skos:definition "Acccording to privacy regulations such as GDPR and CCPA, organizations must store collected data in a secured manner, One of the security mechanisms outline in the regulation is encryption mechanism, which is essentially crambling data into a secret code using a digital key (encrypt) that can be access to the actual data (decrypt) using the same  digital key." .



###  http://umaine.edu/oppo/core/v1#EndToEndEncryptionMechanism

:EndToEndEncryptionMechanism rdf:type owl:Class ;
                             
                             rdfs:label "end-to-end encryption mechanism"@en ;
                             
                             rdfs:subClassOf :EncryptionMechanism ;
                             
                             skos:definition "an encryption mechanism to provide secure communication and prevent a third-party to get access to stored or transferred data." .



###  http://umaine.edu/oppo/core/v1#EthnicPersonalData

:EthnicPersonalData rdf:type owl:Class ;
                    
                    rdfs:label "ethnic personal data"@en ;
                    
                    rdfs:subClassOf gdpr:SpecialCategoryPersonalData ,
                                    :PersonalData ;
                    
                    skos:note "https://grants.nih.gov/grants/guide/notice-files/not-od-15-089.html" ;
                    
                    skos:definition "Data that is associated with revealing an individual's racial or ethnic origin." .



###  http://umaine.edu/oppo/core/v1#FinancialPersonalData

:FinancialPersonalData rdf:type owl:Class ;
                       
                       rdfs:label "financial personal data"@en ;
                       
                       rdfs:subClassOf :PersonalData ;
                       
                       skos:definition "Any information that is related to an invidual's financial status" .



###  http://umaine.edu/oppo/core/v1#FirstPartyDataRecipientRole

:FirstPartyDataRecipientRole rdf:type owl:Class ;
                             
                             rdfs:label "first party data recipient role"@en ;
                             
                             rdfs:subClassOf :DataRecipientRole ;
                             
                             skos:definition "A data recipient role that is realized by an organization when it receives a data item directly from a user."@en .



###  http://umaine.edu/oppo/core/v1#GeneticPersonalData

:GeneticPersonalData rdf:type owl:Class ;
                     
                     rdfs:label "genetic personal data"@en ;
                     
                     rdfs:subClassOf gdpr:SpecialCategoryPersonalData ,
                                     :PersonalData ;
                     
                     skos:definition "Data related to an invidual's genetic characteristics and tests (such as DNA, RNA, Genetic Disease )"@en .



###  http://umaine.edu/oppo/core/v1#HashingMechanism

:HashingMechanism rdf:type owl:Class ;
                  
                  rdfs:label "hashing mechanism"@en ;
                  
                  rdfs:subClassOf :SecurityMechanism ;
                  
                  skos:definition "Hashing a security mechanism that map the actual data into a fixed-length value." .



###  http://umaine.edu/oppo/core/v1#HealthPersonalData

:HealthPersonalData rdf:type owl:Class ;
                    
                    rdfs:label "health personal data"@en ;
                    
                    rdfs:subClassOf gdpr:HealthData ,
                                    :PersonalData ;
                    
                    skos:definition "Any information that is associated to an invidual's health condition" .



###  http://umaine.edu/oppo/core/v1#IdentityPersonalData

:IdentityPersonalData rdf:type owl:Class ;
                      
                      rdfs:label "identity personal data"@en ;
                      
                      rdfs:subClassOf :PersonalData ;
                      
                      skos:note "Any information that can directly identify an individual."@en ;
                      
                      skos:definition "Personal data that directly identifies an individual."@en .



###  http://umaine.edu/oppo/core/v1#IdeologicalPersonalData

:IdeologicalPersonalData rdf:type owl:Class ;
                         
                         rdfs:label "ideological personal data"@en ;
                         
                         rdfs:subClassOf gdpr:SpecialCategoryPersonalData ,
                                         :PersonalData ;
                         
                         skos:definition "Any sort of information that reflects the belief of an individual (such as political, religious belief)"@en .



###  http://umaine.edu/oppo/core/v1#IndefiniteDurationDescription

:IndefiniteDurationDescription rdf:type owl:Class ;
                               
                               rdfs:label "Indefinite Duration Description"@en ;
                               
                               owl:equivalentClass [ rdf:type owl:Class ;
                                                     owl:intersectionOf ( time:GeneralDurationDescription
                                                                          [ rdf:type owl:Class ;
                                                                            owl:complementOf :DefiniteDurationDescription
                                                                          ]
                                                                        )
                                                   ] ;
                               
                               rdfs:subClassOf time:GeneralDurationDescription ;
                               
                               skos:definition "An organization may describe unspecifically (indefinite) how long the collected data will be stored (retention period) (such as as long as they need) or how long the organization may take to response to users' request (response delay) (such as : earliest possible time), referred as indefinite duration description." .



###  http://umaine.edu/oppo/core/v1#IndividualData

:IndividualData rdf:type owl:Class ;
                
                rdfs:label "individual data"@en ;
                
                rdfs:subClassOf obo:IAO_0000027 ;
                
                skos:definition "Data that is associated to an individual." .



###  http://umaine.edu/oppo/core/v1#LegalPersonDataProviderRole

:LegalPersonDataProviderRole rdf:type owl:Class ;
                             
                             rdfs:label "legal person data provider role"@en ;
                             
                             rdfs:subClassOf obo:OMRSE_00000038 ,
                                             :DataProviderRole ;
                             
                             skos:definition "Data subjects are eventually act in a legal person data provider role when they provide their data to an organization. Note that, data subject role and legal person data provider role are not equivalent. The reason is, an organization may collect data about a data subject from a third party in which case the data is still about the data subject, but the data subject does not act as a legal person data provider role"@en .



###  http://umaine.edu/oppo/core/v1#MinorDataSubjectRole

:MinorDataSubjectRole rdf:type owl:Class ;
                      
                      rdfs:label "minor data subject role"@en ;
                      
                      rdfs:subClassOf :DataSubjectRole ;
                      
                      skos:definition "A data subject role that is borne by a natural person who is considered a minor under the applicable privacy regulation."@en .



###  http://umaine.edu/oppo/core/v1#OneFactorAuthenticationMechanism

:OneFactorAuthenticationMechanism rdf:type owl:Class ;
                                  
                                  rdfs:label "one factor authentication mechanism"@en ;
                                  
                                  rdfs:subClassOf :AuthenticationMechanism ;
                                  
                                  skos:definition "a single authentication mechanism that requires matching one factor such as biometric information or password or token." .



###  http://umaine.edu/oppo/core/v1#OpinionPersonalData

:OpinionPersonalData rdf:type owl:Class ;
                     
                     rdfs:label "opinion personal data"@en ;
                     
                     rdfs:subClassOf gdpr:SpecialCategoryPersonalData ,
                                     :PersonalData ;
                     
                     skos:definition "Personal data that describes or reveals an individual's opinions."@en .



###  http://umaine.edu/oppo/core/v1#OrganizationalDataProviderRole

:OrganizationalDataProviderRole rdf:type owl:Class ;
                                
                                rdfs:label "organizational data provider role"@en ;
                                
                                rdfs:subClassOf obo:OMRSE_00000051 ,
                                                :DataProviderRole ;
                                
                                skos:definition "Organization may recieve data from other organization (third-party they are affiliated with), in such cases, the third-party organization acts in organizationalDataProviderRole"@en .



###  http://umaine.edu/oppo/core/v1#PasswordbasedAuthenticationMechanism

:PasswordbasedAuthenticationMechanism rdf:type owl:Class ;
                                      
                                      rdfs:label "Password-based Authentication Mechanism"@en ;
                                      
                                      rdfs:subClassOf :OneFactorAuthenticationMechanism ;
                                      
                                      skos:definition "a single factor authentication mechanism which requires to match user defined password." .



###  http://umaine.edu/oppo/core/v1#PersonalData

:PersonalData rdf:type owl:Class ;
              
              rdfs:label "personal data"@en ;
              
              rdfs:subClassOf :IndividualData ;
              
              skos:note "https://gdpr-info.eu/art-4-gdpr/" ;
              
              skos:definition "Personal data is any data that can directly or indirectly identify an individual." .



###  http://umaine.edu/oppo/core/v1#PrivacyPolicy

:PrivacyPolicy rdf:type owl:Class ;
               
               rdfs:label "privacy policy"@en ;
               
               rdfs:subClassOf obo:IAO_0000030 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasDataPractice ;
                                 owl:someValuesFrom :DataPractice
                               ] ;
               
               skos:definition "A privacy policy is a legal contract between an organization and a privacy regulation that disclose the data practices of an organization in an attempt to comply with an specific privacy regulation." .



###  http://umaine.edu/oppo/core/v1#PrivacyRegulation

:PrivacyRegulation rdf:type owl:Class ;
                   
                   rdfs:label "privacy regulation"@en ;
                   
                   rdfs:subClassOf obo:IAO_0000030 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :allows ;
                                     owl:someValuesFrom :DataPractice
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :disallows ;
                                     owl:someValuesFrom :DataPractice
                                   ] ;
                   
                   skos:definition "A privacy regulation is law or set of rules that are required to be followed by any organization that collect, process, and share personal data about an individual." .



###  http://umaine.edu/oppo/core/v1#PseudonymizationMechanism

:PseudonymizationMechanism rdf:type owl:Class ;
                           
                           rdfs:label "pseudonymization mechanism"@en ;
                           
                           rdfs:subClassOf :SecurityMechanism ;
                           
                           skos:definition "A securoty mechanism to replace personally identifiable information with pseudo or aritifical information." .



###  http://umaine.edu/oppo/core/v1#PseudonymizedPersonalData

:PseudonymizedPersonalData rdf:type owl:Class ;
                           
                           rdfs:label "pseudonymized personal data"@en ;
                           
                           rdfs:subClassOf :PersonalData ;
                           
                           skos:note "https://en.wikipedia.org/wiki/Pseudonymization" ;
                           
                           skos:definition "Personal data that has been replaced using with pseudo or aritifical information." .



###  http://umaine.edu/oppo/core/v1#SecurityMechanism

:SecurityMechanism rdf:type owl:Class ;
                   
                   rdfs:label "security mechanism"@en ;
                   
                   rdfs:subClassOf obo:IAO_0000030 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :appliesTo ;
                                     owl:someValuesFrom obo:IAO_0000027
                                   ] ;
                   
                   skos:definition "An information content entity that describes a security mechanism stated in a privacy policy, such as encryption, authentication, hashing, or pseudonymization."@en .



###  http://umaine.edu/oppo/core/v1#SexualPersonalData

:SexualPersonalData rdf:type owl:Class ;
                    
                    rdfs:label "sexual personal data"@en ;
                    
                    rdfs:subClassOf gdpr:SpecialCategoryPersonalData ,
                                    :PersonalData ;
                    
                    skos:definition "Any data that is associated to the sexual identity of an individual." .



###  http://umaine.edu/oppo/core/v1#SpatialEntity

:SpatialEntity rdf:type owl:Class ;
               
               rdfs:label "spatial entity"@en ;
               
               rdfs:subClassOf obo:BFO_0000141 ;
               
               skos:definition "Spatial location of storing personal data, such as Netharland, Finland." .



###  http://umaine.edu/oppo/core/v1#StatisticalData

:StatisticalData rdf:type owl:Class ;
                 
                 rdfs:label "statistical data"@en ;
                 
                 rdfs:subClassOf :AggregatedData ;
                 
                 skos:definition "Data that are the outcome of the observation of aggregated data." ;
                 
                 skos:note "https://www.statisticalaid.com/statistical-data-definition-types-and-requirements/" .



###  http://umaine.edu/oppo/core/v1#StorageEntity

:StorageEntity rdf:type owl:Class ;
               
               rdfs:label "storage entity"@en ;
               
               rdfs:subClassOf obo:IAO_0000178 ;
               
               skos:definition "Storage type such as on device, or physical data center." .



###  http://umaine.edu/oppo/core/v1#TechnicalPersonalData

:TechnicalPersonalData rdf:type owl:Class ;
                       
                       rdfs:label "technical personal data"@en ;
                       
                       rdfs:subClassOf :PersonalData ;
                       
                       skos:definition "Any data that are associated with an individual's interaction with technology such as device and interenet." .



###  http://umaine.edu/oppo/core/v1#ThirdPartyDataRecipientRole

:ThirdPartyDataRecipientRole rdf:type owl:Class ;
                             
                             rdfs:label "third party data recipient role"@en ;
                             
                             rdfs:subClassOf :DataRecipientRole ;
                             
                             skos:definition "A data recipient role that is realized by an organization when it receives a data item indirectly through another organization."@en .



###  http://umaine.edu/oppo/core/v1#TokenbasedAuthenticationMechanism

:TokenbasedAuthenticationMechanism rdf:type owl:Class ;
                                   
                                   rdfs:label "Token-based Authentication Mechanism"@en ;
                                   
                                   rdfs:subClassOf :OneFactorAuthenticationMechanism ;
                                   
                                   skos:definition "a single factor authentication mechanism which requires to match token." .



###  http://umaine.edu/oppo/core/v1#TwoFactorAuthenticationMechanism

:TwoFactorAuthenticationMechanism rdf:type owl:Class ;
                                  
                                  rdfs:label "two factor authentication mechanism"@en ;
                                  
                                  rdfs:subClassOf :AuthenticationMechanism ;
                                  
                                  skos:definition "Two Factor Authentication Mechanism entails, two steps of One Factor Authentication Mechanism (e.g., Password + Biometrics)" .



###  http://www.w3.org/2006/time#GeneralDurationDescription

time:GeneralDurationDescription rdf:type owl:Class ;
                                
                                rdfs:label "General Duration Description"@en ;
                                
                                owl:disjointUnionOf ( :DefiniteDurationDescription
                                                      :IndefiniteDurationDescription
                                                    ) .





