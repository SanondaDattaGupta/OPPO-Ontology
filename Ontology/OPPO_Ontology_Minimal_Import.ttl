#
#################################################################


###  http://umaine.edu/oppo/core/v1#hasRequestType

:hasRequestType rdf:type owl:DatatypeProperty ;
                
                rdfs:label "has request type" ;
                
                rdfs:domain :DataStorageModificationPractice ;
                
                rdfs:range xsd:string .



###  http://umaine.edu/oppo/core/v1#hasResponseType

:hasResponseType rdf:type owl:DatatypeProperty ;
                 
                 rdfs:label "has response type" ;
                 
                 rdfs:domain :DataStorageModificationPractice ;
                 
                 rdfs:range xsd:string .



